{
  "name": "@consenlabs-fe/eslint-config",
  "type": "module",
  "version": "1.0.0-beta.0",
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "description": "Flat eslint configuration for Consenlabs team",
  "repository": {
    "type": "git",
    "url": "https://github.com/consenlabs/eslint"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsdown --clean --dts",
    "dev": "npx @eslint/config-inspector --config eslint.config.ts",
    "typegen": "tsx scripts/typegen.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.10.0",
  "peerDependencies": {
    "@eslint-react/eslint-plugin": "^1.38.4",
    "eslint": "^9.10.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    },
    "@eslint-react/eslint-plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/config-inspector": "catalog:dev",
    "@stylistic/eslint-plugin": "catalog:prod",
    "@types/node": "catalog:dev",
    "@typescript-eslint/parser": "catalog:prod",
    "eslint": "catalog:peer",
    "eslint-typegen": "catalog:dev",
    "tsdown": "catalog:dev",
    "tsx": "^4.19.4",
    "typescript": "catalog:dev"
  }
}
