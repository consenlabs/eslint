{
  "name": "@consenlabs-fe/eslint-config",
  "type": "module",
  "version": "1.0.0-alpha.0",
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "description": "Flat eslint configuration for Consenlabs team",
  "repository": {
    "type": "git",
    "url": "https://github.com/consenlabs/eslint"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsdown --clean --dts",
    "dev": "npx @eslint/config-inspector --config eslint.config.js",
    "typegen": "tsx scripts/typegen.ts",
    "lint": "eslint"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.10.0",
  "peerDependencies": {
    "@eslint-react/eslint-plugin": "^1.38.4",
    "eslint": "^9.10.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    },
    "@eslint-react/eslint-plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/config-inspector": "catalog:dev",
    "@types/node": "catalog:dev",
    "eslint": "catalog:peer",
    "eslint-typegen": "catalog:dev",
    "jiti": "catalog:dev",
    "tsdown": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "dependencies": {
    "@antfu/install-pkg": "^1.1.0",
    "@clack/prompts": "^0.10.1",
    "@stylistic/eslint-plugin": "catalog:prod",
    "@typescript-eslint/eslint-plugin": "catalog:prod",
    "@typescript-eslint/parser": "catalog:prod",
    "eslint-flat-config-utils": "catalog:prod",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.1.0",
    "local-pkg": "catalog:prod"
  }
}
